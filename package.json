{
  "name": "omgind-react",
  "version": "4.1.0",
  "description": "RBAC权限管理脚手架",
  "private": true,
  "scripts": {
    "start": "max dev",
    "start:no-mock": "cross-env MOCK=none max dev",
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "lint:style": "stylelint \"src/**/*.less\" --custom-syntax postcss-less",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src && npm run lint:style",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src && npm run lint:style",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx src",
    "postinstall": "max setup",
    "preview": "max preview",
    "typecheck": "max setup && tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^3.1.14-2",
    "antd": "^6.6.7",
    "axios": "^1.6.5",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.10",
    "encrypt-storage": "^2.12.22",
    "form-render": "^2.2.7",
    "lodash": "^4.17.21",
    "lodash-decorators": "^6.0.1",
    "md5": "^2.2.1",
    "path-to-regexp": "^6.2.1",
    "qs": "^6.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "setprototypeof": "^1.2.0",
    "superagent": "^8.0.9",
    "url-polyfill": "^1.1.12",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@ant-design/antd-theme-variable": "^1.0.0",
    "@babel/eslint-parser": "^7.19.1",
    "@babel/plugin-proposal-decorators": "^7.20.13",
    "@babel/plugin-syntax-jsx": "^7.18.6",
    "@babel/preset-react": "^7.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "cross-env": "^7.0.3",
    "cross-port-killer": "^1.4.0",
    "eslint": "~8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-formatter-pretty": "^4.1.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-compat": "^4.1.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-markdown": "^3.0.0",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-react": "^7.32.2",
    "husky": "^1.2.0",
    "less-loader": "^7.0.0",
    "lint-staged": "^13.1.2",
    "postcss": "^8.4.32",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.4",
    "stylelint": "^15.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-less": "^1.0.4",
    "stylelint-config-standard": "^30.0.1",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^5.0.0",
    "typescript": "~6.0.3",
    "@umijs/max": "4.7.33",
    "@types/node": "^24.0.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,less}": [
      "prettier --write",
      "git add"
    ],
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.less": "stylelint --custom-syntax postcss-less"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 12",
    "not dead"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint-staged"
    }
  },
  "packageManager": "yarn@1.22.22"
}
